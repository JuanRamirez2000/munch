NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# mock | yelp | google | foursquare — see src/lib/places/index.ts
PLACES_PROVIDER=mock

# Required only when PLACES_PROVIDER=yelp — get one at https://www.yelp.com/developers
YELP_API_KEY=

# Required only when PLACES_PROVIDER=google — Places API (New) key from Google Cloud Console,
# restricted to that API. Also used by /api/photos/google to fetch photo bytes server-side.
GOOGLE_PLACES_API_KEY=
